# Paste into Streamlit app settings > Secrets and replace both placeholders.
# Use the DIRECT connection string from Neon, preserving its TLS options.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
USE_DATABASE = "true"
REQUIRE_POSTGRES = "true"
AUTO_MIGRATE = "true"
DASHBOARD_PASSWORD_HASH = "REPLACE_WITH_YOUR_EXISTING_SHA256_PASSWORD_HASH"

# Optional: copy existing values if you use the report-sharing buttons.
SUPPORT_EMAIL = ""
SUPPORT_WHATSAPP = ""

# Optional: enables AI splitting/categorisation of uploaded WhatsApp chats.
# Leave blank to fall back to one draft per uploaded chat.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
