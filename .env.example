DATABASE_URL=postgresql://user:password@localhost:5432/reporting_dashboard
USE_DATABASE=true
# Legacy shared-password gate, used only in the Google Sheets fallback mode.
DASHBOARD_PASSWORD_HASH=replace-with-a-sha256-password-hash
# Bootstrap admin for named-account mode. Lets someone sign in before any
# accounts are seeded and recover access if every account is locked out. Always
# has the IT global view. Leave blank once real accounts exist.
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD=
SUPPORT_EMAIL=manager@example.com
SUPPORT_WHATSAPP=254700000000
